      </child>
      <child xsi:type="archimate:Note" id="id-ba009175b83f4e3bb204c5ac70fe4c03" textAlignment="1">
        <bounds x="372" y="12" width="325" height="181"/>
        <content>This view provides a consolidated overview of all object relationships within the chosen object domain. COVO guarantees that these relationships are strictly derived from capability interactions in value creation.</content>
      </child>
    </element>
