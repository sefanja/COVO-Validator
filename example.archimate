        <child xsi:type="archimate:DiagramObject" id="id-da5a0b329e0844aeb73e0b989d78dcdb" targetConnections="id-5a8d7a6630b84663bc6d90204c0df6c9" archimateElement="id-6f545124de2646cb9d47e6d920eee6dd">
          <bounds x="12" y="204" width="145" height="73"/>
          <sourceConnection xsi:type="archimate:Connection" id="id-7a9c63f8f2b64e408e2b651afb97bf27" source="id-da5a0b329e0844aeb73e0b989d78dcdb" target="id-69e0f31a60354413a14698eeea87633f" archimateRelationship="id-96cb31a591f54ee0b205c375440a6df0"/>
          <child xsi:type="archimate:DiagramObject" id="id-69e0f31a60354413a14698eeea87633f" targetConnections="id-7a9c63f8f2b64e408e2b651afb97bf27" textPosition="1" archimateElement="id-dfba8f17bb21440e8dd4d491581cfb9c">
