        <child xsi:type="archimate:DiagramObject" id="id-3fcd2abd1de04ffcaa11184475f18c33" targetConnections="id-6fc3b00ed2ff463fb925e1e98ff13189" archimateElement="id-6bbf772c77654970b7a70432c5af74f9">
          <bounds x="12" y="288" width="145" height="73"/>
          <sourceConnection xsi:type="archimate:Connection" id="id-698526ce52314317bd32056b4ba22500" source="id-3fcd2abd1de04ffcaa11184475f18c33" target="id-932e24bb751e4a4d83b4a04785292a9b" archimateRelationship="id-fcb44d122fed48e285edccc9b366e1ba"/>
          <child xsi:type="archimate:DiagramObject" id="id-932e24bb751e4a4d83b4a04785292a9b" targetConnections="id-698526ce52314317bd32056b4ba22500" textPosition="1" archimateElement="id-8264a58c947c4e68b7640bc3a048ba33">
            <bounds x="12" y="36" width="120" height="25"/>
